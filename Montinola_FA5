names = ["Glaiza", "Vyn", "Ashie"]

steps = [
    [5000, 5200, 4800, 5000, 5300],
    [4000, 4100, 3900, 4200, 4600],
    [3900, 4800, 4500, 3200, 2500]
]

days = ["Monday", "Tuesday", "Wednesday", 'Thursday', "Friday"]
day_totals = []

for x in range(len(days)):
    total = 0
    for i in range(len(steps)):
        total += steps[i][x]  
    day_totals.append(total)
    print(days[x], "total steps:", total)


max_total = max(day_totals)
max_index = day_totals.index(max_total)
print("\nMost active da:", days[max_index], "with", max_total, "steps")
