names = ["Glaiza", "Vyn", "Ashie"]

steps = [
    [5000, 5200, 4800, 5000, 5300],
    [4000, 4100, 3900, 4200, 4600],
    [3900, 4800, 4500, 3200, 2500]
]


totals = []

for i in range(len(steps)):
    total = sum(steps[i])
    totals.append(total)
    print(names[i], "total steps:", total)

max_total = max(totals)
min_total = min(totals)
max_index = totals.index(max_total)
min_index = totals.index(min_total)
print("\nPerson with the highest steps:", names[max_index], "with", max_total, "steps")

difference = max_total - min_total
print("Highest and lowest difference:", difference)
